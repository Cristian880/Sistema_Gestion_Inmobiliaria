@model List<PropertyViewModel>
@{
    ViewData["Title"] = "Browse Properties";
}

<div class="row g-4">
    @if (Model.Count == 0)
    {
        <div class="col-12">
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle"></i> No properties available at this time. Please check back soon!
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    else
    {
        foreach (var property in Model.Where(p => p.Active))
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm overflow-hidden">
                    <img src="@property.PropertyImage" class="card-img-top" alt="@property.Name" style="object-fit: cover; height: 250px;">
                    <div class="card-body">
                        <h5 class="card-title">@property.Name</h5>
                        <p class="card-text text-muted small">@property.Direction</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 text-success fw-bold">$@property.Price.ToString("N0")</span>
                            <span class="badge bg-success">Active</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top">
                        <a href="#" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-info-circle"></i> View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
