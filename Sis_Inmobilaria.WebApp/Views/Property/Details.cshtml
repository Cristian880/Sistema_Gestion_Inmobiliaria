@model PropertyViewModel
@{
    ViewData["Title"] = "Property Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="display-5">
                    <i class="bi bi-house-door"></i> Property Details
                </h1>
                <a class="btn btn-outline-secondary" asp-controller="Property" asp-action="Index">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Imagen Principal -->
        <div class="col-12 col-lg-6 mb-4">
            <div class="card shadow-sm">
                @if (!string.IsNullOrEmpty(Model.PropertyImage))
                {
                    <img src="@Model.PropertyImage" class="card-img-top responsive-image" " alt="@Model.Name" /> @*style="max-height: 500px; object-fit: cover;">*@
                }
                else
                {
                    <img src="~/Images/no-image.png" class="card-img-top responsive-image" " alt="No image" style="max-height: 500px; object-fit: cover;">
                }
            </div>
        </div>

        <!-- Información Detallada -->
        <div class="col-12 col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="card-title mb-3">@Model.Name</h2>

                    <div class="mb-4">
                        <span class="badge bg-primary fs-6">@Model.PropertyTypeId</span>
                        @if (Model.Active)
                        {
                            <span class="badge bg-success fs-6 ms-2">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 ms-2">Inactive</span>
                        }
                    </div>

                    <div class="mb-3">
                        <h4 class="text-success">
                            <i class="bi bi-currency-dollar"></i> @Model.Price.ToString("N2")
                        </h4>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-6">
                            <p class="mb-2">
                                <i class="bi bi-rulers text-primary"></i>
                                <strong>Size:</strong>
                            </p>
                            <p class="ms-4">@Model.Size m²</p>
                        </div>
                        <div class="col-6">
                            <p class="mb-2">
                                <i class="bi bi-calendar-event text-primary"></i>
                                <strong>Published:</strong>
                            </p>
                            <p class="ms-4">@Model.PropertyPublicacionDate.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <p class="mb-2">
                            <i class="bi bi-geo-alt text-primary"></i>
                            <strong>Address:</strong>
                        </p>
                        <p class="ms-4">@Model.Direction</p>
                    </div>

                    <div class="mb-3">
                        <p class="mb-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            <strong>Description:</strong>
                        </p>
                        <p class="ms-4 text-muted">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <em>No description available</em>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Botones de Acción -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Actions</h5>
                    <div class="d-flex gap-2">
                        <a class="btn btn-warning" asp-controller="Property" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="bi bi-pencil"></i> Edit Property
                        </a>
                        <a class="btn btn-danger" asp-controller="Property" asp-action="Delete" asp-route-id="@Model.Id">
                            <i class="bi bi-trash"></i> Delete Property
                        </a>
                        <a class="btn btn-outline-secondary ms-auto" asp-controller="Property" asp-action="Index">
                            <i class="bi bi-list"></i> View All Properties
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .card-img-top {
        border-radius: 10px 10px 0 0;
    }
</style>