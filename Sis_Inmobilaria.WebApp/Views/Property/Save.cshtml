@model SavePropertyViewModel
@{
    bool editMode = (ViewBag?.EditMode as bool?) ?? false;
    ViewData["Title"] = "Property save";
    var propertyTypes = ViewBag.PropertyTypes ?? new List<object>();
}

<div class="col-12 col-md-6 offset-md-3 ">
    <div class="card">
        <div class="card-header bg-success text-light"><h5 class="text-center">@(editMode ? "Edit - " + Model.Name : "New Property ")</h5></div>
        <div class="card-body">
            <form asp-controller="Property" asp-action="@(editMode ? "Edit" : "Create")" method="POST" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Name:</label>
                    <input class="form-control" asp-for="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Direction" class="form-label">Direction:</label>
                    <input class="form-control" asp-for="Direction" />
                    <span asp-validation-for="Direction" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PropertyTypeId" class="form-label">Property Type:</label>
                    <select asp-for="PropertyTypeId" class="form-select" asp-items="@(new SelectList(propertyTypes, "Id", "Name"))">
                        <option value="0">Select any option</option>
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price:</label>
                    <input class="form-control" asp-for="Price" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Size" class="form-label">Size:</label>
                    <input class="form-control" asp-for="Size" />
                    <span asp-validation-for="Size" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description:</label>
                    <textarea class="form-control" asp-for="Description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PropertyImageFile" class="form-label">Profile Image:</label>
                    <input class="form-control" asp-for="PropertyImageFile" />
                    <span asp-validation-for="PropertyImageFile" class="text-danger"></span>
                </div>
                <div>
                    <button type="submit" class="btn btn-outline-primary float-end"><i class="bi bi-floppy2"></i> Save</button>
                    <a asp-controller="Property" asp-action="Index" class="btn btn-outline-warning float-end me-2"><i class="bi bi-arrow-left-short"></i> Back to list</a>
                </div>
            </form>
        </div>
    </div>
</div>
