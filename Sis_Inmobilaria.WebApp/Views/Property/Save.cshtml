@model SavePropertyViewModel
@{
    bool editMode = (ViewBag?.EditMode as bool?) ?? false;
    ViewData["Title"] = editMode ? "Edit Property" : "Create New Property";
    var propertyTypes = ViewBag.PropertyTypes ?? new List<object>();
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="text-center mb-0">
                        <i class="bi bi-@(editMode ? "pencil-square" : "file-earmark-plus")"></i>
                        @(editMode ? "Edit Property - " + Model.Name : "Create New Property")
                    </h4>
                </div>
                <div class="card-body">
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                    <form asp-controller="Property" asp-action="@(editMode ? "Edit" : "Create")" method="POST" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Property Name</label>
                            <input class="form-control form-control-lg" asp-for="Name" placeholder="Enter property name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Direction" class="form-label fw-bold">Address</label>
                            <input class="form-control form-control-lg" asp-for="Direction" placeholder="Enter full address" />
                            <span asp-validation-for="Direction" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PropertyTypeId" class="form-label fw-bold">Property Type</label>
                                <select asp-for="PropertyTypeId" class="form-select form-select-lg" asp-items="@(new SelectList(propertyTypes, "Id", "Name"))">
                                    <option value="0">Select property type</option>
                                </select>
                                <span asp-validation-for="PropertyTypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold">Price ($)</label>
                                <input class="form-control form-control-lg" asp-for="Price" placeholder="0.00" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Size" class="form-label fw-bold">Size (m²)</label>
                            <input class="form-control form-control-lg" asp-for="Size" placeholder="Enter property size" />
                            <span asp-validation-for="Size" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea class="form-control" asp-for="Description" rows="4" placeholder="Enter property description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PropertyImageFile" class="form-label fw-bold">Property Image</label>
                            <input class="form-control form-control-lg" type="file" asp-for="PropertyImageFile" accept="image/*" />
                            <span asp-validation-for="PropertyImageFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <a asp-controller="Property" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-floppy2"></i> Save Property
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
