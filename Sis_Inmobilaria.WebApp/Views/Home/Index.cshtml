@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-speedometer2"></i> Admin Dashboard
        </h1>
        <p class="text-muted">Welcome to your Real Estate Management System</p>
    </div>
</div>

<div class="row g-4">
    <!-- Property Types Card -->
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-list-check text-primary fs-4"></i>
                    </div>
                    <h5 class="card-title ms-3 mb-0">Property Types</h5>
                </div>
                <p class="card-text text-muted small">Manage all property types in your system</p>
            </div>
            <div class="card-footer bg-white border-top">
                <a asp-controller="PropertyType" asp-action="Index" class="btn btn-primary w-100">
                    <i class="bi bi-arrow-right"></i> View Types
                </a>
            </div>
        </div>
    </div>

    <!-- Properties Card -->
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-house text-success fs-4"></i>
                    </div>
                    <h5 class="card-title ms-3 mb-0">Properties</h5>
                </div>
                <p class="card-text text-muted small">Create and manage property listings</p>
            </div>
            <div class="card-footer bg-white border-top">
                <a asp-controller="Property" asp-action="Index" class="btn btn-success w-100">
                    <i class="bi bi-arrow-right"></i> View Properties
                </a>
            </div>
        </div>
    </div>

    <!-- Users Card -->
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-people text-info fs-4"></i>
                    </div>
                    <h5 class="card-title ms-3 mb-0">Users</h5>
                </div>
                <p class="card-text text-muted small">Manage system users and permissions</p>
            </div>
            <div class="card-footer bg-white border-top">
                <a asp-controller="User" asp-action="Index" class="btn btn-info w-100">
                    <i class="bi bi-arrow-right"></i> View Users
                </a>
            </div>
        </div>
    </div>
</div>
