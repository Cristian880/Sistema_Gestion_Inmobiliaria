@model List<PropertyTypeViewModel>;
@{
    ViewData["Title"] = "PropertyType";
}

<div class="row">
    <div class="text-center">
        <h1 class="display-4">Property types</h1>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12 col-md-3">
        <a class="btn btn-outline-success" asp-controller="PropertyType" asp-action="Create"><i class="bi bi-file-earmark-plus"></i> New Property Type</a>
    </div>

</div>

<div class="row mt-2">
    @if (Model.Count == 0)
    {
        <div class="text-center">
            <h4 class="display-4">There aren't Property types</h4>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="col-12 col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name </h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Description: @item.Description</li>
                    </ul>
                    <div class="card-body">
                        <a class="btn btn-outline-danger float-end me-2" asp-controller="PropertyType" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i> Delete</a>
                        <a class="btn btn-outline-danger float-end me-2" asp-controller="PropertyType" asp-action="Save" asp-route-id="@item.Id"><i class="bi bi-trash"></i> Edit</a>

                    </div>
                </div>
            </div>
        }
    }
</div>



