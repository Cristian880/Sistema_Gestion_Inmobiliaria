<!-- PropertyType Index.cshtml -->
@model List<PropertyTypeViewModel>;
@{
    ViewData["Title"] = "PropertyType";
    bool showingInactive = ViewContext.RouteData.Values["Action"]?.ToString() == "InactivePropertyTypes";
}

<div class="row">
    <div class="text-center">
        <h1 class="display-4">@(showingInactive ? "Inactive Property Types" : "Property Types")</h1>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12 col-md-3">
        @if (!showingInactive)
        {
            <a class="btn btn-outline-success" asp-controller="PropertyType" asp-action="Create">
                <i class="bi bi-file-earmark-plus"></i> New Property Type
            </a>
        }
    </div>
    @if (!showingInactive) @*&& User.IsInRole("Admin")) *@
    {
        <div class="col-12 col-md-3">
            <a class="btn btn-outline-secondary" asp-controller="PropertyType" asp-action="InactivePropertyTypes">
                <i class="bi bi-archive"></i> View Inactive Types
            </a>
        </div>
    }
    @if (showingInactive)
    {
        <div class="col-12 col-md-3">
            <a class="btn btn-outline-primary" asp-controller="PropertyType" asp-action="Index">
                <i class="bi bi-arrow-left-short"></i> Back to Active Types
            </a>
        </div>
    }
</div>

<div class="row mt-4">
    @if (Model.Count == 0)
    {
        <div class="text-center">
            <h4 class="display-4">@(showingInactive ? "There are no inactive property types" : "There aren't property types")</h4>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="col-12 col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted">@item.Description</p>
                        @if (item.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                    <div class="card-footer bg-white border-top">
                        @if (!showingInactive)
                        {
                            <a class="btn btn-outline-warning btn-sm me-2" asp-controller="PropertyType" asp-action="Edit" asp-route-id="@item.Id">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a class="btn btn-outline-danger btn-sm" asp-controller="PropertyType" asp-action="Delete" asp-route-id="@item.Id">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        }
                        else
                        {
                            <form asp-controller="PropertyType" asp-action="Reactivate" asp-route-id="@item.Id" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-arrow-counterclockwise"></i> Reactivate
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>