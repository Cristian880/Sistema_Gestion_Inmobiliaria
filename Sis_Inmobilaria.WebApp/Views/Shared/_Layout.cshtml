<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inmobiliaria Itla</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                 @if (User.IsInRole("Admin"))
                    {
                        <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Inmobiliaria Itla
                        </a>
                    }
                    else if (User.IsInRole("GeneralPublic"))
                    {
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="GeneralPublic" asp-action="Index">
                        <i class="bi bi-house-door"></i>Inmobiliaria Itla
                    </a>
                    }
                    else
                    {
                        
                    }
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="PropertyType" asp-action="Index">Property Types</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Property" asp-action="Index">Properties</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="User" asp-action="Index">Users</a>
                            </li>
                        }
                        else if (User.IsInRole("GeneralPublic"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="GeneralPublic" asp-action="Index">Properties</a>
                            </li>
                        }
                        else {}
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <span class="text-white me-3">Hello, @User.Identity?.Name</span>
                            <a class="nav-link text-white" asp-area="" asp-controller="Login" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        }
                        else{}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid flex-grow-1">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white mt-auto py-4">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <h6>Real Estate Management System</h6>
                    <p class="small">Professional property management platform</p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="small">&copy; @DateTime.Now.Year - All rights reserved</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
